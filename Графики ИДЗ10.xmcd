			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:matrix rows="2" cols="1">
						<ml:apply>
							<ml:indexer/>
							<ml:id xml:space="preserve">IL</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:indexer/>
							<ml:id xml:space="preserve">UC</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
						</ml:apply>
					</ml:matrix>
					<ml:apply>
						<ml:plus/>
						<ml:matrix rows="2" cols="1">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">IL</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">UC</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
						</ml:matrix>
						<ml:apply>
							<ml:mult/>
							<ml:id xml:space="preserve">δt</ml:id>
							<ml:parens>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:mult/>
										<ml:matrix rows="2" cols="2">
											<ml:real>-1</ml:real>
											<ml:real>-1</ml:real>
											<ml:real>1</ml:real>
											<ml:real>-1</ml:real>
										</ml:matrix>
										<ml:matrix rows="2" cols="1">
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">IL</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">UC</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:matrix>
									</ml:apply>
									<ml:matrix rows="2" cols="1">
										<ml:real>-2</ml:real>
										<ml:real>4</ml:real>
									</ml:matrix>
								</ml:apply>
							</ml:parens>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
